{
  "name": "greenstreet-dscr-engine",
  "private": true,
  "version": "0.1.0",
  "main": "dist/function.cjs",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild src/engineWorker.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/engineWorker.cjs && esbuild src/function.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/function.cjs && esbuild src/serverApp.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/_app.cjs && npm run prerender",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "prerender": "tsx scripts/prerender.ts",
    "test:prerender": "tsx scripts/check-prerender.ts",
    "test:ftc": "tsx scripts/check-ftc-contract.ts",
    "qa:interactions": "node scripts/interaction-qa.mjs",
    "test": "vitest run",
    "test:home-fidelity": "node scripts/check-home-contract.mjs",
    "test:project-brain": "node scripts/check-project-brain-contract.mjs",
    "test:delivery": "node scripts/check-delivery-contract.mjs",
    "test:watch": "vitest",
    "test:unit": "vitest run --project node",
    "test:dom": "vitest run --project dom"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.1",
    "@supabase/supabase-js": "^2.112.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "firebase": "^12.15.0",
    "gsap": "^3.15.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "fast-xml-parser": "5.10.1",
    "protobufjs": "7.6.5"
  }
}
