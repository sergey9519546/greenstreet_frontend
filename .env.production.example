# ── PRODUCTION environment ────────────────────────────────────
# Copy this to .env for production deployments.
# Never commit .env to source control.

NODE_ENV=production

# ── Server ────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Your production domain — used for CORS and sitemap
APP_URL=https://greenstreet.capital
ALLOWED_ORIGINS=https://greenstreet.capital,https://www.greenstreet.capital

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Firebase (VITE_ prefix → exposed to browser bundle) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
