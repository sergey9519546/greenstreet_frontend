# ── PRODUCTION environment ────────────────────────────────────
# Copy this to .env for production deployments.
# Never commit .env to source control.

NODE_ENV=production

# ── Server ────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Your production domain — used for CORS and sitemap
APP_URL=https://www.greenstreet.finance
ALLOWED_ORIGINS=https://greenstreet.finance,https://www.greenstreet.finance

# ── API authentication ────────────────────────────────────────
# Optional global enforcement for all /api routes. /api/narrate is protected
# directly and always requires `Authorization: Bearer <Firebase ID token>`.
REQUIRE_AUTH=false

# Never enable a development bypass in production. The code ignores this value
# when NODE_ENV=production, even if it is accidentally set to true.
ALLOW_DEV_AUTH_BYPASS=false

# ── Lead ingestion / abuse controls ──────────────────────────
# Exact number of trusted reverse-proxy hops used to resolve the client IP.
# Zero trusts only the direct peer and is the safest default. Set 1 (or higher)
# only after confirming the production platform's complete proxy chain; never
# configure a blanket `true`, which permits spoofed forwarding headers.
TRUST_PROXY_HOPS=0

# REQUIRED for POST /api/leads. Generate at least 32 random bytes with:
#   openssl rand -base64 32
# Inject through the deployment secret manager, keep the same value on every
# instance, and never commit or reuse it. Missing/short values fail closed (503).
LEAD_RATE_LIMIT_HASH_SECRET=

# Production-safe durable fixed-window limit per HMAC-derived client-IP key.
# Attempts are counted transactionally in Firestore; storage errors fail closed.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=3600

# Firebase Admin uses Application Default Credentials for ID-token verification
# and Firestore quota transactions. Prefer an attached least-privilege service
# account in production. Set project ID explicitly when the runtime needs it.
GCLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_AUTH_TOKEN=
# Leave blank to use the official https://api.anthropic.com endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Custom gateways must be explicitly listed as comma-separated HTTPS origins.
# Example: https://gateway.example.com,https://backup-gateway.example.com
ANTHROPIC_BASE_URL_ALLOWLIST=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Durable per-user fixed-window quota stored transactionally in Firestore.
NARRATION_QUOTA_WINDOW_SECONDS=3600
NARRATION_QUOTA_MAX_REQUESTS=20

# ── Firebase (VITE_ prefix → exposed to browser bundle) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Privacy-safe measurement ────────────────────────────────
# Keep disabled until every account ID, production domain filter, consent signal,
# internal-traffic exclusion, and data-retention setting has been verified.
# Prefer one verified GTM container; leave direct GA/Ads blank when GTM owns tags.
VITE_ANALYTICS_ENABLED=false
VITE_GTM_CONTAINER_ID=
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_VECTOR_PIXEL_ID=
VITE_COOKIEYES_CLIENT_ID=
