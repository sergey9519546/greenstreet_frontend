rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail() {
      return request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    // Deal payload validation — applied IDENTICALLY on create AND update so an
    // owner cannot reassign userId or drop required fields via update.
    function isValidDeal() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'createdAt', 'title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.createdAt is timestamp;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow create: if isOwner(userId) && isValidEmail();
      allow update: if isOwner(userId);
      allow delete: if false; // Soft-delete only — never allow hard delete
    }

    // ── Deal history ──────────────────────────────────────────────────────────
    // Users can only read/write their own deal history.
    match /deals/{dealId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidDeal();
      // Update must (a) own the existing doc AND (b) keep userId == self +
      // required fields — closes the ownership-reassignment update bypass.
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && isValidDeal();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Audit logs ────────────────────────────────────────────────────────────
    // Users can create their own audit logs and read them.
    // No one can update or delete audit logs (immutable record).
    match /auditLogs/{logId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'userEmail', 'type', 'timestamp'])
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 100
                    && request.resource.data.userEmail is string
                    && request.resource.data.userEmail.size() <= 200
                    && request.resource.data.timestamp is timestamp;
      allow update: if false;
      allow delete: if false;
    }

    // ── Leads (server-only ingestion) ─────────────────────────────────────────
    // Lead creation is handled by POST /api/leads through firebase-admin. Admin
    // SDK requests bypass Firestore rules; all browser/client access is denied.
    match /leads/{leadId} {
      allow read, write: if false;
    }

    // ── Block everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
