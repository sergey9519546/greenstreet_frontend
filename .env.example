# ──────────────────────────────────────────────────────────
# Greenstreet DSCR Engine — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Anthropic / Claude ────────────────────────────────────
# Get your API key from https://console.anthropic.com
ANTHROPIC_AUTH_TOKEN=

# Leave blank to use https://api.anthropic.com. HTTPS is mandatory.
ANTHROPIC_BASE_URL=

# Required only for a custom ANTHROPIC_BASE_URL. Comma-separated HTTPS origins
# only (no paths), for example: https://gateway.example.com
ANTHROPIC_BASE_URL_ALLOWLIST=

# Override the model used for narration (optional)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Per-user paid narration quota, enforced atomically in Firestore
NARRATION_QUOTA_WINDOW_SECONDS=3600
NARRATION_QUOTA_MAX_REQUESTS=20

# Optional global API auth. /api/narrate always requires a Firebase ID token,
# regardless of this setting.
REQUIRE_AUTH=false

# Local development only. Ignored when NODE_ENV=production. When true, protected
# routes use one fixed local identity without verifying a Firebase ID token.
ALLOW_DEV_AUTH_BYPASS=false

# ── Lead ingestion / abuse controls ───────────────────────
# Exact number of trusted reverse-proxy hops used to resolve the client IP.
# Keep 0 unless the deployment's proxy chain is known; never use a blanket true.
TRUST_PROXY_HOPS=0

# Required by POST /api/leads. Generate at least 32 random bytes, for example:
#   openssl rand -base64 32
# Store this as a secret, keep it stable across instances/deployments, and never
# commit or reuse it. If blank or too short, lead submission fails closed (503).
LEAD_RATE_LIMIT_HASH_SECRET=

# Durable fixed-window submission-attempt limit per HMAC-derived client-IP key.
# Firestore transaction failures also fail closed; raw IP addresses are not stored.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=3600

# Firebase Admin uses Application Default Credentials for token verification and
# narration quotas. In local development, point this to a service-account file.
# In managed production runtimes, prefer the platform's attached service account.
GOOGLE_APPLICATION_CREDENTIALS=
GCLOUD_PROJECT=

# ── Firebase (client-side; VITE_ prefix exposes to browser) ─
# Find these in Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── App ───────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Privacy-safe measurement (all disabled by default) ────
# Set true only after account ownership, domain scoping, consent behavior, and
# production exclusions have been verified. Configure GTM or direct GA, not both.
VITE_ANALYTICS_ENABLED=false
VITE_GTM_CONTAINER_ID=
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_VECTOR_PIXEL_ID=
VITE_COOKIEYES_CLIENT_ID=

# The consent UI/provider must call:
# window.greenstreetAnalyticsConsent(true|false)
# or dispatch greenstreet:analytics-consent with detail { granted: boolean }.

# Optional normalized JSON exports consumed by scripts/seo-report.mjs.
SEO_GA4_EXPORT=
SEO_SEARCH_CONSOLE_EXPORT=
SEO_RANKINGS_EXPORT=
SEO_GEO_EXPORT=
SEO_BACKLINKS_EXPORT=
SEO_WEB_VITALS_EXPORT=
