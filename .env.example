# GREENSTREET FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# === Development Flags ===
NODE_ENV=development

# === Firebase Client Configuration ===
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# === Supabase Client Configuration ===
# These values are exposed to the browser bundle by design. Configure the
# project's publishable/anon key here; never use a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# === Firebase Admin (Server-side only) ===
# WARNING: These should ONLY be set in server environment, never in client bundle
# Firebase Admin SDK credentials for server-side lead intake. In Firebase
# Functions, Application Default Credentials are provided automatically. For
# local use, set GOOGLE_APPLICATION_CREDENTIALS to a service-account file; for
# a non-Google host, set this deployment secret to the full service-account JSON.
# Never prefix this variable with VITE_ and never commit its value.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# === Lead intake delivery ===
# Lead submissions are stored atomically in Firestore by their client-generated
# UUID. No webhook, CRM, email, or analytics destination is configured in this
# repository, so there are intentionally no LEAD_WEBHOOK_* variables here.
# Add an outbound destination only after its owner, HTTPS endpoint, authorized
# payload fields, authentication secret, retention policy, and idempotency
# contract have been approved.

# === Anthropic / Claude ===
# Get your API key from https://console.anthropic.com
ANTHROPIC_AUTH_TOKEN=

# Leave blank to use the default Anthropic API endpoint
ANTHROPIC_BASE_URL=

# Override the model used for narration (optional)
ANTHROPIC_MODEL=claude-sonnet-4-6

# === App ===
APP_URL=http://localhost:3000

# === Engine ===
# Number of worker_threads used to run DSCR solves in parallel. Set to 0 to
# disable worker_threads and run synchronously in-process (useful on
# memory-constrained serverless instances). Defaults to 4 if unset.
# WORKER_POOL_SIZE=4

# === Dev auth ===
# Auth is fail-closed: if firebase-admin cannot initialize, a request carrying a
# bearer token is rejected with 401 rather than being granted a mock identity.
# Set this to the exact string "true" to opt into a static "dev-user-id"
# identity for local work without real Firebase credentials. It is ignored
# whenever NODE_ENV=production — production never injects a mock user.
# ALLOW_DEV_AUTH_BYPASS=true

# Reject every unauthenticated request (no bearer token) across /api/*.
# Off by default because /api/dscr/* is public/demo by product design.
# REQUIRE_AUTH=true

# === Rate limiting ===
# The default in-memory rate-limit store resets on every serverless cold start
# and is not shared between concurrent instances, so configured limits are
# really per-instance (a one-time warning says so in production).
# Set to "true" to persist counters in Firestore instead, shared across
# instances. Requires working firebase-admin credentials and a private HMAC
# secret of at least 32 bytes; the secret turns client rate-limit keys into
# opaque Firestore document IDs. Store it only as a deployment secret, never
# in a VITE_* variable. If either prerequisite is unavailable the server logs
# a safe error and keeps the memory store rather than failing startup.
# RATE_LIMIT_FIRESTORE=true
# RATE_LIMIT_FIRESTORE_HMAC_SECRET=
#
# Collection holding the counter documents (default: apiRateLimits). Add a
# Firestore TTL policy on the `expiresAt` field of this collection so expired
# windows are reaped automatically.
# RATE_LIMIT_FIRESTORE_COLLECTION=apiRateLimits
