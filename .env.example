# ──────────────────────────────────────────────────────────
# Greenstreet DSCR Engine — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Anthropic / Claude ────────────────────────────────────
# Get your API key from https://console.anthropic.com
ANTHROPIC_AUTH_TOKEN=

# Leave blank to use the default Anthropic API endpoint
ANTHROPIC_BASE_URL=

# Override the model used for narration (optional)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Firebase (client-side — VITE_ prefix exposes to browser) ─
# Find these in Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── App ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
