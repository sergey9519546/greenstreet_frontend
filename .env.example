# GREENSTREET FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# === Development Flags ===
NODE_ENV=development

# === Firebase Client Configuration ===
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# === Firebase Admin (Server-side only) ===
# WARNING: These should ONLY be set in server environment, never in client bundle
# Firebase Admin SDK credentials for server-side lead intake. In Firebase
# Functions, Application Default Credentials are provided automatically. For
# local use, set GOOGLE_APPLICATION_CREDENTIALS to a service-account file; for
# a non-Google host, set this deployment secret to the full service-account JSON.
# Never prefix this variable with VITE_ and never commit its value.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# === Anthropic / Claude ===
# Get your API key from https://console.anthropic.com
ANTHROPIC_AUTH_TOKEN=

# Leave blank to use the default Anthropic API endpoint
ANTHROPIC_BASE_URL=

# Override the model used for narration (optional)
ANTHROPIC_MODEL=claude-sonnet-4-6

# === App ===
APP_URL=http://localhost:3000

# === Engine ===
# Number of worker_threads used to run DSCR solves in parallel. Set to 0 to
# disable worker_threads and run synchronously in-process (useful on
# memory-constrained serverless instances). Defaults to 4 if unset.
# WORKER_POOL_SIZE=4

# === Dev auth ===
# Bypass Firebase token verification for local development without real
# Firebase credentials. Ignored (never bypasses auth) when NODE_ENV=production.
# ALLOW_DEV_AUTH_BYPASS=true
