{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      "node_modules",
      "**/node_modules/**",
      ".git",
      ".agents",
      ".gemini",
      "src",
      "public",
      "hf-deal",
      "hf-dscr",
      "hf-lender",
      "hf-montecarlo",
      "hf-returns",
      "hf-statelaws",
      "hf-step1",
      "hf-step2",
      "hf-step3",
      "hf-step4",
      "hf-step5",
      "hf-stress",
      "hf-tax",
      ".cake_matrices",
      "animations",
      "assets",
      "docs",
      "graphify-out",
      "scripts",
      "_regen_tmp",
      "pgliteData",
      "dist/assets",
      "dist/img",
      "dist/video",
      "dist/index.html",
      "dist/server.cjs.map",
      "dist/engineWorker.cjs.map",
      "dist/function.cjs.map",
      "review-logos-standalone.html",
      "review-logos.html",
      ".trash",
      ".minimax",
      ".qodo",
      "*.png",
      "*.jpg",
      "*.html",
      "*.ps1",
      "*.log",
      "vite.config.ts",
      "tsconfig.json"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/foreign-nationals", "destination": "/non-us-investors", "type": 301 },
      { "source": "/portfolio-builders", "destination": "/tools/portfolio", "type": 301 },
      { "source": "/partners", "destination": "/partnerships", "type": 301 },
      { "source": "/privacy-policy", "destination": "/legal/privacy-policy", "type": 301 },
      { "source": "/terms-of-service", "destination": "/legal/terms-of-service", "type": 301 },
      { "source": "/book-demo", "destination": "/rate-quiz", "type": 301 },
      { "source": "/decision-support", "destination": "/tools/decision-support", "type": 301 },
      { "source": "/tools/arm", "destination": "/tools/arm-reset", "type": 301 },
      { "source": "/tools/irr", "destination": "/tools/returns", "type": 301 },
      { "source": "/tools/dscr-calculator", "destination": "/dscr-calculator", "type": 301 },
      { "source": "/tools/lender-intel", "destination": "/lender-intel", "type": 301 },
      { "source": "/tools/state-laws", "destination": "/state-laws", "type": 301 },
      { "source": "/tools/deal-analyzer", "destination": "/deal-analyzer", "type": 301 },
      { "source": "/tools/borrower-profiles", "destination": "/borrower-profiles", "type": 301 },
      { "source": "/dashboard", "destination": "/investgo", "type": 301 },
      { "source": "/broker-portal", "destination": "/investgo", "type": 301 },
      { "source": "/tools/workspace", "destination": "/investgo/analyze", "type": 301 },
      { "source": "/tools/deal-workspace", "destination": "/investgo/analyze", "type": 301 },
      { "source": "/tools/sensitivity", "destination": "/investgo/sensitivity", "type": 301 },
      { "source": "/tools/structure-optimizer", "destination": "/investgo/optimize", "type": 301 },
      { "source": "/tools/scenario-history", "destination": "/investgo/history", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
