rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail() {
      return request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    // Deal payload validation — applied IDENTICALLY on create AND update so an
    // owner cannot reassign userId or drop required fields via update.
    function isValidDeal() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'createdAt', 'title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.createdAt is timestamp;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow create: if isOwner(userId) && isValidEmail();
      allow update: if isOwner(userId);
      allow delete: if false; // Soft-delete only — never allow hard delete
    }

    // ── Deal history ──────────────────────────────────────────────────────────
    // Users can only read/write their own deal history.
    match /deals/{dealId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidDeal();
      // Update must (a) own the existing doc AND (b) keep userId == self +
      // required fields — closes the ownership-reassignment update bypass.
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && isValidDeal();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Audit logs ────────────────────────────────────────────────────────────
    // Users can create their own audit logs and read them.
    // No one can update or delete audit logs (immutable record).
    match /auditLogs/{logId} {
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'userEmail', 'type', 'timestamp'])
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 100
                    && request.resource.data.userEmail is string
                    && request.resource.data.userEmail.size() <= 200
                    && request.resource.data.timestamp is timestamp;
      allow update: if false;
      allow delete: if false;
    }

    // ── Leads (See If You Qualify form) ────────────────────────────────────────
    // Anonymous users can submit lead forms. No one can read/update/delete leads.
    // Field validation: require the minimal expected fields and cap string lengths
    // to prevent junk/spam writes and oversized document abuse.
    match /leads/{leadId} {
      allow create: if
        // Must include these fields — extra fields are permitted (Firestore doesn't strip them)
        request.resource.data.keys().hasAll(['submittedAt']) &&
        request.resource.data.submittedAt is timestamp &&
        // Enforce string length caps on common text fields (if present)
        (!('email' in request.resource.data) || request.resource.data.email is string && request.resource.data.email.size() <= 200) &&
        (!('name' in request.resource.data)  || request.resource.data.name  is string && request.resource.data.name.size()  <= 200) &&
        (!('phone' in request.resource.data)  || request.resource.data.phone  is string && request.resource.data.phone.size()  <= 30)  &&
        (!('message' in request.resource.data) || request.resource.data.message is string && request.resource.data.message.size() <= 2000);
      allow read, update, delete: if false;
    }

    // ── Block everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
