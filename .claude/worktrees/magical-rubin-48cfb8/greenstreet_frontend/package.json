{
  "name": "greenstreet-dscr-engine",
  "private": true,
  "version": "0.1.0",
  "main": "dist/function.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/engineWorker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/engineWorker.cjs && esbuild src/function.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/function.cjs && esbuild src/serverApp.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/_app.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "qa:interactions": "node scripts/interaction-qa.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase": "^12.15.0",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "puppeteer": "^25.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
