{
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/{vercel,engineWorker}.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/leads",
      "destination": "https://us-central1-gen-lang-client-0809198072.cloudfunctions.net/api/api/leads"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
